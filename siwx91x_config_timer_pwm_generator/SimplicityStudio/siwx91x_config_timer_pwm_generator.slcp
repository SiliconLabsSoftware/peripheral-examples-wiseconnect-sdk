project_name: siwx91x_config_timer_pwm_generator
label: Peripheral Example - Config Timer - PWM Generator
description: >
  This application demonstrates how to configure the config timer to generate a PWM signal on a GPIO pin.
  The GPIO pin is configured as an output and the config timer is set to toggle the pin at a specific frequency and duty cycle.
category: Example|Platform
package: platform
quality: evaluation

filter:
  - name: Device Type
    value: [SoC]
  - name: Project Difficulty
    value: [Beginner]

source:
  - path: ../src/app.c

include:
  - path: '../inc'
    file_list:
    - path: app.h
    
component:
  - id: sl_main
  - id: status
  - id: syscalls
    from: wiseconnect3_sdk
  - id: si91x_memory_default_config
    from: wiseconnect3_sdk

readme:
  - path: ../README.md

other_file:
  - path: ../image/result.png
    directory: "image"

ui_hints:
  highlight:
    - path: README.md
      focus: true

sdk_extension:
  - id: wiseconnect3_sdk
    version: 3.5.2